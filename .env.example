# Backend HTTP URL. Include /api/v1 exactly once; no credentials or trailing slash needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional override; defaults to the HTTP origin and path with ws/wss protocol.
# NEXT_PUBLIC_API_WS_BASE_URL=ws://localhost:8000/api/v1
# Set to false to disable live notifications explicitly.
NEXT_PUBLIC_NOTIFICATIONS_WS_ENABLED=true
# Disabled in local/CI until a configured Mercado Pago sandbox is available.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
